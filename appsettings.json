{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiSettings": {
    "DefaultPageSize": 25,
    "MaxPageSize": 50
  },
  "LibrarySettings": {
    "BorrowingLimit": 5
  },
  "Jwt": {
    "Issuer": "LibraryApi",
    "Audience": "LibraryClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays":  7
  }
}
